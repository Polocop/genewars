; gwrecomp.ini (optional): copy this file to gwrecomp.ini next to gw_demo_sdl2.exe (<build root>\bin) or into the
; build root, and edit it. It is read in play mode (--play) only. Command-line flags win when given explicitly:
; --classic / --widescreen / --zoomout, --res, --fullscreen / --windowed, and scripts\play.ps1 -Fps.

; zoomout   : 854x480 at 1.0x on a 1152x640 map canvas, wheel zoom 0.87x..2.0x, Home back to 1.0x
; widescreen: 854x480, wheel zoom 1.0x..2.0x
; classic   : the original 640x480
mode = zoomout

; window size in physical pixels: 2160p, 1440p, 1080p, 900p or WxH (the game still renders 640/854 x 480;
; the output is GPU-scaled). auto or empty: the default window.
resolution = 2160p

; 1 = borderless fullscreen at the desktop resolution
fullscreen = 0

; presentation rate (30..240); the simulation keeps the game's own tick rate
fps = 120

; your own Gene Wars 1.1 GENEWARS folder; used when GENEWARS_INSTALL_DIR / gwrecomp.local.json do not set one
; data_dir = C:\path\to\GENEWARS

; ---- also written by the launcher (gw_demo_sdl2.exe started with no arguments, or play.ps1 -Launcher) ----
; display filter, same as F7 in game (F7 updates this line): sharp, epx or crt
filter = sharp
; start value of the F8 turbo: 1, 2 or 4
turbo = 1
; 1 = WASD / arrow keys scroll the map; 1 = middle-button drag scrolls the map
camera_keys = 1
middle_drag = 1
; 1 = skip the start-up videos
skip_intro = 0
; 1 = show the launcher when the program starts without arguments (--launcher always shows it, --fast-launch never)
launcher = 1
; language of the launcher and of GWRecomp's own messages: es (Spanish), en (English) or auto (follows the Windows
; display language); also the ES / EN buttons at the top of the launcher. The game keeps its own texts.
language = auto
; mission selected in the launcher's mission list (1..24)
last_mission = 1
; .cue of your own Gene Wars CD image, for the CD music (else GENEWARS_CUE)
; (also the launcher's PLAY tab, CD IMAGE button; without it, a .cue next to the GENEWARS folder is found by itself)
; cd_cue = C:\path\to\genewars.cue
; 1 = 3D terrain in zoomout missions (every wheel zoom, 0.87x to 2x): smooth lighting from the planet's heights,
;     sun and sky light of the biome, micro-relief, up to 4x the canvas resolution. Ctrl+F9 toggles 2D/3D live.
terrain_3d = 1
; 1 = directional shadow map of hills, ridges and crater rims on the 3D terrain (never darker than a tactical floor)
terrain_3d_shadows = 1
; 1 = 3D water: coastal colour from the depth, shore foam, animated waves with Fresnel and sun glints, glowing GOOP
terrain_3d_water = 1
; 1 = dynamic point lights on the 3D slopes: the cyan Ethereal beam, warm shots / explosions / sparks, building and
;     Gene Pod lights, a soft green glow around GOOP (only on explored terrain). Ctrl+F11 toggles them live.
terrain_3d_lights = 1
; 1 = HD terrain tiles, if you made some: hd_textures\<BANK>\atlas.png (or tile_000.png ...) next to gwrecomp.exe,
;     exported from your own install with tools/export_b32_tiles.py and upscaled with your own tools. Without the
;     folder the original 1996 tiles are used unchanged; sprites, HUD and texts are never touched. Ctrl+F12 toggles
;     the HD tiles live (before / after on the same frame).
terrain_3d_hd_tiles = 1
; folder holding the <BANK> folders, instead of hd_textures next to the exe
; terrain_3d_hd_dir = C:\path\to\hd_textures
; 1 = light and particle preset of the planet's own terrain bank (organic, arid Brown, toxic-alien, icy): sun colour
;     and height, shadow light, valley AO, liquid tint, ambient dust / spores / snow. 0 = guess it from the colours
terrain_3d_biome_presets = 1
; 1 = the mouse wheel zoom of the map eases smoothly (Home = back to 1x); 0 = each wheel notch applies at once
terrain_3d_smooth_zoom = 1
; 1 = the pointer follows the mouse every presented frame (120 Hz); 0 = it moves once per game tick, like the original
cursor_120hz = 1
; 1 = remove the 1-pixel slivers the original terrain drawing leaves on the planet's horizon (shown frame only)
clean_horizon = 1
; 1 = animated water ripples and caustics on the sea and soft highlights on GOOP, in missions only (presented frame
;     only: the game itself is unchanged); not shown with the EPX filter
water_effects = 1
; 1 = enhanced audio: positional sound panning/distance fitted to the visible map (854 / zoom-out), +-4.5 % random
;     pitch on sound effects (never on speech, videos or CD music), CD music lowered 30 % while a voice speaks
enhanced_audio = 1
; music volume 0..100 (the CD music tracks, a separate host output; 0 = silence, 50 = about half as loud)
music_volume = 100
; sound effects volume 0..100 (all of the game's digital sound: effects and voices, mixed by the game into one
; stream). The intro videos follow the louder of the two. Only the PC's audio output changes, never the game.
sfx_volume = 100
; 1 = selective GPU emissive bloom (Dual Kawase) on energy beams, explosions, Gene Pod lights and GOOP, in missions only
emissive_bloom = 1
; bloom strength (0.0 .. 1.5, default 0.65)
bloom_intensity = 0.65
; 1 = terrain ambient occlusion (GPU): crater floors, valleys, creases and the foot of hills darken from the real
;     terrain heights, whatever the light direction (missions only, presented frame only; needs OpenGL)
;     terrain_ao_strength = darkest occlusion, 0.0 .. 1.0 (default 0.40)
terrain_ao = 1
terrain_ao_strength = 0.40
; 1 = soft shadows: the game's hard shadows (ships, flyers, buildings) redrawn from the terrain with soft edges
soft_shadows = 1
; 1 = 4K particles (GPU, window resolution, every presented frame): drifting spores and sea mist on green planets,
;     dust and sand gusts on arid ones, ash and embers on dark ones, snow on icy ones, plus energy sparks and dust
;     around the Ethereal ship and its teleport beam. Missions only, never over the HUD.
;     particle_density = amount, 0.0 .. 2.0 (default 1.0)
hd2d_particles = 1
particle_density = 1.0
